# A senha aqui precisa ser a mesma POSTGRES_PASSWORD do .env da raiz.
DATABASE_URL="postgresql://naicotech:TROQUE_POR_UMA_SENHA_FORTE@localhost:5433/naicotech_store?schema=public"
JWT_SECRET=GERE_UM_SEGREDO_LONGO_ALEATORIO
MERCADOPAGO_ACCESS_TOKEN=TEST-seu-access-token-de-teste
MERCADOPAGO_WEBHOOK_SECRET=chave-secreta-do-webhook

# Link usado nos e-mails de confirmação.
FRONTEND_URL=http://localhost:5173
# E-mail: em dev, Mailpit do docker compose (caixa em http://localhost:8025).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="NaicoTech Store <nao-responda@naicotech.local>"

# --- Produção ---
# NODE_ENV=production ativa cookie Secure (só HTTPS) e checagens extras do .env.
# NODE_ENV=production
# Número de proxies na frente da API (ex.: 1 atrás de Nginx/Cloudflare), para o rate limit ver o IP real.
# TRUST_PROXY=1
# Outras origens permitidas além do FRONTEND_URL, separadas por vírgula.
# CORS_ORIGINS=https://www.sualoja.com.br
# PORT=3000

# Criptografa os segredos da verificação em duas etapas no banco (64 caracteres hex).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOTP_ENCRYPTION_KEY=GERE_UMA_CHAVE_HEX_DE_64_CARACTERES

# --- Frete (Melhor Envio) ---
# Token: painel do Melhor Envio > Gerenciar > Tokens (sandbox: sandbox.melhorenvio.com.br).
MELHOR_ENVIO_TOKEN=cole-o-token-do-melhor-envio
# true (padrão) = sandbox, sem cobrança. Em produção: false + token da conta real.
MELHOR_ENVIO_SANDBOX=true
# Nome da aplicação + e-mail de contato (exigido pela API do Melhor Envio).
MELHOR_ENVIO_USER_AGENT="NaicoTech Store (seu-email@exemplo.com)"
# CEP de onde os pacotes saem.
SHIPPING_ORIGIN_CEP=TROQUE_POR_SEU_CEP
# Opcional: só oferecer esses serviços (IDs do Melhor Envio, ex.: 1=PAC, 2=SEDEX).
# SHIPPING_SERVICES=1,2
# Opcional: agência de postagem por transportadora (empresa=agência), exigida pela Jadlog.
# SHIPPING_AGENCIES=2=123456
# Remetente impresso na etiqueta (só é exigido na hora de gerar etiqueta).
SHIPPING_SENDER_NAME=
SHIPPING_SENDER_PHONE=
SHIPPING_SENDER_EMAIL=
SHIPPING_SENDER_DOCUMENT=
SHIPPING_SENDER_STREET=
SHIPPING_SENDER_NUMBER=
SHIPPING_SENDER_COMPLEMENT=
SHIPPING_SENDER_DISTRICT=
SHIPPING_SENDER_CITY=
SHIPPING_SENDER_STATE=

# Criptografa os endereços dos clientes no banco (LGPD). Chave PRÓPRIA, diferente da do TOTP.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADDRESS_ENCRYPTION_KEY=GERE_UMA_CHAVE_HEX_DE_64_CARACTERES

# Envio comercial (loja com CNPJ emitindo NF-e). Sem isso, os pacotes vão com
# declaração de conteúdo e o seguro é limitado a R$ 1.000 por pacote.
# SHIPPING_COMMERCIAL=true
# SHIPPING_SENDER_CNPJ=
# SHIPPING_SENDER_IE=

# Criptografa os IPs guardados no registro de auditoria (LGPD). Chave própria, diferente das outras.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_ENCRYPTION_KEY=GERE_UMA_CHAVE_HEX_DE_64_CARACTERES

# --- Demo online (Vercel + Render) — veja docs/DEPLOY.md ---
# Produção com pagamento e frete de teste (portfólio). Nunca em uma loja real.
# DEMO_MODE=true
# Segredo compartilhado com o middleware do Vercel: a API recusa chamadas que não venham dele.
# PROXY_SECRET=
