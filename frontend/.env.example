# Base da API. Em dev o proxy do Vite redireciona /api para http://localhost:3000.
VITE_API_URL=/api
# Public Key do Mercado Pago (painel > Credenciais). É pública por natureza, vai no bundle do front.
VITE_MP_PUBLIC_KEY=APP_USR-sua-public-key

# Loja demonstrativa (portfólio): mostra o aviso no topo e nas páginas legais.
# Numa loja real: VITE_DEMO_MODE=false e preencha a identificação do vendedor
# (obrigatória pelo Decreto 7.962/2013).
VITE_DEMO_MODE=true
# VITE_STORE_LEGAL_NAME=
# VITE_STORE_DOCUMENT=
# VITE_STORE_ADDRESS=
# VITE_STORE_CONTACT_EMAIL=
